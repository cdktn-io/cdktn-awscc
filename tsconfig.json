{
  // "tools/awscc2cdk/src/vendored/spec2cdk/**" is excluded from the build: it is a byte-identical
  // vendored copy (see src/vendored/VENDORED.md, checked by vendored.test.ts) of upstream spec2cdk
  // files that import packages not on npm (`@aws-cdk/pkglint`) or not worth adding just for types
  // (`@cdklabs/typewriter`). We never compile the vendored copy; the functions we actually use from
  // it (propertyNameFromCloudFormation, sanitizeTypeName, santitizeFieldName,
  // modulePartsFromNamespace, namespaceToModuleDefinition, ModuleDefinition) are re-implemented as
  // adapted copies under src/naming.ts and src/grouped/, which this tsconfig does compile.
  // Iteration-2 debt (a), CONTRACT.md "Iteration 2 — debt from iteration 1".
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "sourceMap": true,
    "outDir": "out/tsc",
    "rootDir": ".",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "tools/**/*.ts"],
  "exclude": [
    "node_modules",
    "out",
    "generated",
    "tools/awscc2cdk/src/vendored/spec2cdk/**"
  ]
}
