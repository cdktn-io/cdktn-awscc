{
  "name": "@cdktn/awscc",
  "version": "0.0.0",
  "private": true,
  "description": "awscc bindings in the aws-cdk-lib L1 shape (PoC, phase 1)",
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "test": "jest",
    "test:full": "RUN_FULL=1 jest",
    "fixture": "python3 tools/awscc2cdk/test/fixtures/extract-fixture.py",
    "fixture:check": "python3 tools/awscc2cdk/test/fixtures/extract-fixture.py --check",
    "spike:naming": "jest tools/awscc2cdk/test/spike-naming.test.ts",
    "test:jsii": "RUN_JSII=1 jest tools/awscc2cdk/test/step4.jsii.test.ts",
    "test:pacmak": "RUN_JSII=1 RUN_PACMAK=1 jest tools/awscc2cdk/test/step4.jsii.test.ts",
    "generate": "ts-node --transpile-only tools/awscc2cdk/bin/generate-all.ts",
    "test:full-jsii": "RUN_FULL_JSII=1 jest tools/awscc2cdk/test/step6.full-jsii.test.ts",
    "lazify": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' ts-node --transpile-only tools/lazify/bin/lazify.ts",
    "docgen": "ts-node --transpile-only tools/awscc2cdk/bin/docgen.ts aws-ec2 # runs jsii-docgen over the staged module"
  },
  "dependencies": {
    "@aws-cdk/aws-service-spec": "0.1.206",
    "@aws-cdk/service-spec-types": "0.0.272",
    "@cdktn/commons": "0.24.0",
    "@cdktn/provider-schema": "0.24.0",
    "camelcase": "^6.3.0",
    "cdktn": "0.24.0",
    "codemaker": "^1.117.0",
    "constructs": "^10.7.0",
    "fs-extra": "^11.4.0"
  },
  "devDependencies": {
    "@cdklabs/typewriter": "0.0.16",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "aws-cdk-lib": "^2.267.0",
    "jest": "^29.7.0",
    "jsii": "~5.9.53",
    "jsii-docgen": "^10.12.5",
    "jsii-pacmak": "^1.140.0",
    "ts-jest": "^29.2.5",
    "ts-node": "10.9.2",
    "typescript": "~5.9.3"
  }
}
